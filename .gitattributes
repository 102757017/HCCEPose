# Windows 上 core.autocrlf=true 会把 .sh 检出成 CRLF，导致 bash 报
# $'\r': command not found。shell 脚本必须强制 LF。
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf

# Windows 批处理需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 模型权重 / 网格 / 压缩包
*.pt binary
*.pth binary
*.onnx binary
*.ply binary
*.stl binary
*.zip binary
